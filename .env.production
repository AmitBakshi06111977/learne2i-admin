# Production environment for the admin SPA
# This is read at build time by Vite (only when building, not at runtime).
# VITE_API_URL is the absolute base URL of the Learne2i .NET API. The admin
# SPA on admin.learne2i.com needs an absolute URL because there is no
# vite proxy in production (unlike the dev server on port 5181).
VITE_API_URL=https://learne2i.com
